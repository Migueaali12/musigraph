# ── MusiGraph environment ──────────────────────────────────────────────────
# Copy to .env.local and fill in. Everything here is SERVER-ONLY: none of
# these variables are exposed to the browser bundle.

# Discogs API personal access token. While it is missing, the Discogs
# enrichment source disables itself automatically (reported as "skipped").
DISCOGS_TOKEN=

# ── Wikidata SPARQL endpoint (WDQS v1 → v2 cutover, phase 5) ───────────────
# Set to true to switch the Wikidata provider to the v2 endpoints once they
# are public (expected Nov 2026). Rollback is flipping it back to false.
# WDQS_V2_ENABLED=false

# Explicit endpoint override. Takes precedence over WDQS_V2_ENABLED and is
# useful for staging or local tests against a mirror/proxy.
# WDQS_ENDPOINT=https://query-next.wikidata.org/sparql
